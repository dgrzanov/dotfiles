# Ghostty config — see `ghostty +show-config --default --docs` for all options

# Primary font: Iosevka Term Regular, 15pt
font-family = "Iosevka Term"
font-style = Regular
font-size = 20

# Everything outside ASCII (accents, symbols, Nerd Font icons, powerline glyphs)
# is rendered with MesloLGS NF
font-codepoint-map = U+0080-U+10FFFF=MesloLGS NF

# Fallback if a glyph is missing from Iosevka Term
font-family = "MesloLGS NF"

# Colors: LCARS Classic, generated by ~/lcars-colorscheme (npm run build)
theme = ~/lcars-colorscheme/themes/lcars-classic.ghostty
